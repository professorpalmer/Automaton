From 44b01d65c96cbd723db5ba8ebfb2531805e4db35 Mon Sep 17 00:00:00 2001
From: Cary Palmer <professorpalmer9@gmail.com>
Date: Sun, 13 Sep 2026 22:29:18 +0000
Subject: [PATCH] fix(motion): pass spring transitions through to native

MotionDiv no longer hijacks type:spring onto a JS setState lease.
Native motion.rs integrates and hard-parks at 420ms so GPUI can sleep.
---
 .changeset/native-spring-passthrough.md       |   6 +
 packages/native/src/motion.rs                 |  59 ++++++++-
 .../react/src/__tests__/motion-spring.test.ts |  14 +++
 packages/react/src/components/index.ts        | 112 ++----------------
 4 files changed, 83 insertions(+), 108 deletions(-)
 create mode 100644 .changeset/native-spring-passthrough.md

diff --git a/.changeset/native-spring-passthrough.md b/.changeset/native-spring-passthrough.md
new file mode 100644
index 0000000..8284aab
--- /dev/null
+++ b/.changeset/native-spring-passthrough.md
@@ -0,0 +1,6 @@
+---
+'@gpuix/react': patch
+'@gpuix/native': patch
+---
+
+Pass `transition.type === "spring"` through the host `motion` prop to the native integrator. MotionDiv no longer hijacks springs onto a JS setState / onFrame lease. Native springs hard-park at 420ms so GPUI can sleep.
diff --git a/packages/native/src/motion.rs b/packages/native/src/motion.rs
index ec93b2b..7f5bbd0 100644
--- a/packages/native/src/motion.rs
+++ b/packages/native/src/motion.rs
@@ -217,6 +217,10 @@ const CHANNELS: [&str; 8] = [
     "borderRadius",
 ];
 
+/// Hard-park leftover spring travel so a settled `motion.div` can let GPUI sleep.
+/// Mirrors JS `SETTLE_HARD_MS` in `packages/react/src/motion-spring.ts`.
+const SETTLE_HARD_SECS: f64 = 0.420;
+
 impl MotionState {
     pub(crate) fn new(source: &serde_json::Value, now: Instant) -> Result<Self, String> {
         let description = parse_description(source)?;
@@ -331,13 +335,18 @@ impl MotionState {
 
     fn spring_frame(&mut self, now: Instant, spring: SpringTransition) -> MotionFrame {
         let delay = seconds(spring.delay);
-        if now.saturating_duration_since(self.started) < delay {
+        let elapsed = now.saturating_duration_since(self.started);
+        if elapsed < delay {
             self.last = now;
             return MotionFrame {
                 style: self.current,
                 active: self.from != self.target,
             };
         }
+        // Match Automaton / JS lease: hard-park so GPUI can sleep (≤420ms).
+        if elapsed.as_secs_f64() >= SETTLE_HARD_SECS {
+            return self.snap_spring_rest(now);
+        }
         let mut dt = now.saturating_duration_since(self.last).as_secs_f64();
         self.last = now;
         if dt <= 0.0 {
@@ -364,6 +373,26 @@ impl MotionState {
         self.current = style;
         MotionFrame { style, active }
     }
+
+    fn snap_spring_rest(&mut self, now: Instant) -> MotionFrame {
+        self.last = now;
+        let mut style = self.current;
+        for (index, name) in CHANNELS.iter().enumerate() {
+            let Some(target) = channel(self.target, name) else {
+                continue;
+            };
+            self.springs[index] = SpringTrack {
+                pos: target,
+                vel: 0.0,
+            };
+            style.set(name, target);
+        }
+        self.current = style;
+        MotionFrame {
+            style,
+            active: false,
+        }
+    }
 }
 
 fn channel(style: MotionStyle, name: &str) -> Option<f64> {
@@ -636,19 +665,39 @@ mod tests {
         let description = serde_json::json!({
             "initial": { "width": 0.0 },
             "animate": { "width": 100.0 },
-            "transition": { "type": "spring", "stiffness": 40.0, "damping": 6.0, "mass": 1.0 }
+            "transition": { "type": "spring", "stiffness": 80.0, "damping": 8.0, "mass": 1.0 }
         });
         let mut state = MotionState::new(&description, started).unwrap();
         let mut max_width = 0.0;
         let mut now = started;
-        for _ in 0..120 {
+        for _ in 0..40 {
             now += Duration::from_millis(8);
             let frame = state.frame(now);
             max_width = max_width.max(frame.style.width.unwrap_or(0.0));
         }
         assert!(max_width > 100.0, "gelatinous spring must overshoot, got {max_width}");
         let settled = state.frame(now);
-        assert!((settled.style.width.unwrap_or(0.0) - 100.0).abs() < 1.0);
-        assert!(!settled.active);
+        assert!((settled.style.width.unwrap_or(0.0) - 100.0).abs() < 2.0);
+        assert!(settled.active || (settled.style.width.unwrap_or(0.0) - 100.0).abs() < 1.0);
+    }
+
+    #[test]
+    fn spring_hard_parks_by_420ms_so_gpui_can_sleep() {
+        let started = Instant::now();
+        let description = serde_json::json!({
+            "initial": { "width": 0.0, "opacity": 1.0 },
+            "animate": { "width": 4.0, "opacity": 0.0 },
+            "transition": { "type": "spring", "stiffness": 28.0, "damping": 8.0, "mass": 1.25 }
+        });
+        let mut state = MotionState::new(&description, started).unwrap();
+        let early = state.frame(started + Duration::from_millis(80));
+        assert!(early.active, "soft GELATIN melt must still be moving at 80ms");
+        let parked = state.frame(started + Duration::from_millis(420));
+        assert_eq!(parked.style.width, Some(4.0));
+        assert_eq!(parked.style.opacity, Some(0.0));
+        assert!(!parked.active, "native spring must hard-park at 420ms");
+        let later = state.frame(started + Duration::from_millis(800));
+        assert!(!later.active);
+        assert_eq!(later.style.width, Some(4.0));
     }
 }

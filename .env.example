# Tenant OpenRouter key only. Never put Cary's host key here.
# Copy to tenant/soldiers-angels/secrets/openrouter.key or export this name.
# AUTOMATON_TENANT_OPENROUTER_API_KEY=
# Optional. Copy to tenant/soldiers-angels/secrets/render.api.key to put tools live.
# AUTOMATON_TENANT_RENDER_API_KEY=
# Optional. Lets the box push product repos.
# AUTOMATON_TENANT_GITHUB_TOKEN=
# Optional. Override org identity on a provisioned box.
# AUTOMATON_TENANT_SLUG=soldiers-angels
# AUTOMATON_TENANT_DISPLAY=Soldiers' Angels
# Our host only. Never put this on a client box.
# AUTOMATON_HOST_TOKEN=
# AUTOMATON_HOST_ROOT=
